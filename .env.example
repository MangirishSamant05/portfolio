# Copy to .env.local for local development, and set the same values in your
# hosting dashboard (Vercel → Project → Settings → Environment Variables).

# Your live URL — used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://mangirish-samant.vercel.app

# Optional: a form endpoint (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty and the contact section shows email and links only.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
